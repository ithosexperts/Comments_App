# Copy this file to .env for local development. Never commit .env.
APP_ENV=local
PORT=8000

# LOCAL PREVIEW IDENTITY ONLY. Set to an actual Active='Y' OffEmail in your local .env.
# In production, disable local identity and launch Comments from signed-in One Portal.
DEV_USER_EMAIL=local.user@hosexperts.com
LOCAL_DEV_IDENTITY_ENABLED=true

# Must be the SAME random 48+ character secret in Comments backend and One Portal backend.
# Generate with: py -c "import secrets; print(secrets.token_urlsafe(48))"
COMMENTS_LAUNCH_SECRET=
COMMENTS_SESSION_MINUTES=480
COMMENTS_SESSION_COOKIE=task_comments_session
COMMENTS_COOKIE_SAMESITE=none

# Use Test API for development. This can read and write to Test_OperationsDB.
# Use mock for a fully offline preview. Do not use Production while debugging.
SQL_API_MODE=test
TEST_SQL_API_URL=https://api.hosexperts.com:85/apiv2.php
PRODUCTION_SQL_API_URL=https://api.hosexperts.com:85/apiv3.php
SQL_API_TOKEN=
SQL_API_TIMEOUT_SECONDS=20
ALLOW_PRODUCTION_WRITES=false

# Existing SQL Server objects; set names unqualified for the PHP CRUD API.
SQL_COMMENTS_TABLE=FMS_Comment_Log
SQL_STAGE_MAP_TABLE=FMS_Comment_FMS_Stage_Map
SQL_USERS_TABLE=VM_EmployeeMaster
SQL_APP_MASTER_TABLE=TM_Application_Master
SQL_PENDING_TASKS_TABLE=Pending_Tasks
SQL_CASE_MAP_TABLE=FMS_Comment_Case_Map
SQL_CASE_LABELS_TABLE=FMS_Case_Labels

# Optional separate integrations
CASE_SYSTEM_API_URL=
CASE_URL_BASE=https://systems-suraj.github.io/CASESYSTEM/
UPLOAD_TUNNEL_URL=
UPLOAD_DIR=data/uploads
